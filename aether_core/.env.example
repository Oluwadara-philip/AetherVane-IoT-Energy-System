# AetherVane Aether Core Engine — Environment Variables
# ========================================================
# This file holds secret settings that should NOT be in the source code.
# It's like keeping your passwords in a locked drawer instead of taped
# to the wall.
#
# Copy this file to ".env" (without the "example") and fill in your real values.
# The .env file is ignored by Git so your secrets stay private.
#
# HOW IT WORKS:
# The python-decouple package reads this file automatically.
# In settings.py, we use: from decouple import config; SECRET = config('SECRET_KEY')
# This pulls the value from here instead of hardcoding it.

# Django's secret key — used for cryptographic signing (passwords, tokens, sessions).
# In production this MUST be a long random string. For development, the default is fine.
SECRET_KEY=django-insecure-change-this-to-a-random-string-for-production

# Database settings
# DEBUG=True shows detailed error pages during development.
# Set to False in production (it would be a security risk otherwise).
DEBUG=True

# MySQL database connection details
DB_NAME=aethervane_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Allowed hosts — which domain names/IPs can access the server.
# Use * during development to allow any host.
ALLOWED_HOSTS=*
